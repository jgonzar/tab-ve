DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Household PIN gate (README, "Access"). Generate the hash with
# `pnpm exec tsx scripts/hash-pin.ts`, and the secret with `openssl rand -base64 48`.
HOUSEHOLD_PIN_HASH=
SESSION_SECRET=

# Optional: DEMO_MODE=on turns the gate off; PUBLIC_DEMO_URL shows the demo link on the gate.
# DEMO_MODE=on
# PUBLIC_DEMO_URL=
