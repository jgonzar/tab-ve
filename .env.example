DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Household PIN gate (README, "Access"). Generate the hash with
# `pnpm exec tsx scripts/hash-pin.ts`, and the secret with `openssl rand -base64 48`.
HOUSEHOLD_PIN_HASH=
SESSION_SECRET=

# Optional: DEMO_MODE=on turns the gate off; PUBLIC_SITE_URL shows the link to Tab's landing page on the gate.
# DEMO_MODE=on
# PUBLIC_SITE_URL=https://tab-ve-site.vercel.app/es/
