{
  "name": "tab",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "pnpm i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy custom-tab baseLocale --is-server import.meta.env.SSR",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@inlang/paraglide-js": "2.25.4",
    "@inlang/plugin-message-format": "4.4.4",
    "@sveltejs/adapter-vercel": "^5.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^25.7.0",
    "dotenv": "^16.0.0",
    "drizzle-kit": "^0.31.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@neondatabase/serverless": "^0.10.0",
    "daisyui": "^5.0.0",
    "driver.js": "1.8.0",
    "drizzle-orm": "^0.40.0",
    "svelte-sileo": "^1.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
